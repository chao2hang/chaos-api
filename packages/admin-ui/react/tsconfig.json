{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@chaos_team/admin-ui-core": ["../core/src/index.ts"],
      "@chaos_team/admin-ui-core/*": ["../core/src/*"],
      "react": ["../../../web/node_modules/@types/react/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
