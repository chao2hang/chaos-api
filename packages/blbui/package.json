{
  "name": "@chaos_team/blbui",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian Industrial Console component library for React, Vue and Svelte.",
  "workspaces": [
    "core",
    "react",
    "vue",
    "svelte",
    "docs-site",
    "business",
    "business-react"
  ],
  "type": "module",
  "scripts": {
    "typecheck:core": "../../web/node_modules/.bin/tsgo -p core/tsconfig.json",
    "typecheck:react": "../../web/node_modules/.bin/tsgo -p react/tsconfig.json",
    "test": "vitest run",
    "format:check": "oxfmt --check core/src react/src vue/src svelte/src",
    "format": "oxfmt --write core/src react/src vue/src svelte/src",
    "typecheck:vue": "../../web/node_modules/.bin/tsgo -p vue/tsconfig.json",
    "check:svelte": "node scripts/check-svelte.mjs",
    "typecheck": "bun run typecheck:core && bun run typecheck:react && bun run typecheck:vue && bun run typecheck:business && bun run typecheck:business-react && bun run typecheck:docs",
    "docs:dev": "cd docs-site && bun run dev",
    "docs:build": "cd docs-site && bun run build",
    "docs:preview": "cd docs-site && bun run preview",
    "typecheck:business": "../../web/node_modules/.bin/tsgo -p business/tsconfig.json",
    "typecheck:business-react": "../../web/node_modules/.bin/tsgo -p business-react/tsconfig.json",
    "docs:check": "cd docs-site && bun run test:smoke",
    "build:packages": "bun scripts/build-packages.mjs",
    "pack:check": "bun run build:packages && npm pack --dry-run --workspaces --if-present",
    "typecheck:docs": "../../web/node_modules/.bin/tsgo -p docs-site/tsconfig.json",
    "catalog:check": "node scripts/check-catalog.mjs",
    "release:check": "bun run catalog:check && bun run typecheck && bun run check:svelte && bun run docs:check && bun run build:packages"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.0",
    "lit": "^3.3.0",
    "react": "^19.0.0",
    "svelte": "^5.0.0",
    "typescript": ">=5.7.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.0"
  }
}
