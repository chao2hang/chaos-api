{
  "name": "@chaos_team/blbui-core",
  "version": "0.1.0",
  "description": "Framework-agnostic industrial admin components based on Web Components.",
  "license": "AGPL-3.0-or-later",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/register.js",
    "./dist/styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./src/register.ts",
      "import": "./dist/register.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./tokens.css": {
      "types": "./dist/tokens.css.d.ts",
      "default": "./dist/tokens.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "lit": ">=3.0.0"
  }
}
